{
  "name": "dsh-white",
  "productName": "Dsh-white",
  "version": "0.1.8",
  "private": true,
  "description": "Unofficial desktop distribution of DeepSeek Harness: an Electron shell wrapping `dsh web`.",
  "author": {
    "name": "irmia2026",
    "email": "irmia2026@users.noreply.github.com"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "license": "MIT",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "materialize": "node scripts/materialize.mjs",
    "predev": "node scripts/materialize.mjs",
    "dev": "electron .",
    "build:dir": "node scripts/materialize.mjs && electron-builder --dir",
    "build:win": "node scripts/materialize.mjs && electron-builder --win",
    "build:mac": "node scripts/materialize.mjs && electron-builder --mac",
    "build:linux": "node scripts/materialize.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
